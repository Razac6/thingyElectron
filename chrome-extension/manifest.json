{
  "manifest_version": 3,
  "name": "Thingy Companion",
  "version": "1.7.0",
  "description": "Companion extension for Thingy app. Syncs Focus Mode and blocks distractions.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:3333/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "assets/16x16.png",
    "48": "assets/48x48.png",
    "128": "assets/128x128.png"
  }
}
