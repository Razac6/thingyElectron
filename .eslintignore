# .erb build/config scripts and chrome-extension aren't part of the main app's TS program
# (tsconfig.json no longer includes chrome-extension; .erb scripts never were) - typed lint
# rules can't parse files outside that program, so keep them out of the main lint pass.
.erb
chrome-extension
.eslintrc.js
